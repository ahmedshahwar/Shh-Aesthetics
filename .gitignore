# ─────────────────────────────────────────────
# Shh Aesthetics & Wellness
# Files Git should never track.
# ─────────────────────────────────────────────

# Dependencies (reinstalled with `npm install`, never committed)
node_modules/
.pnp
.pnp.js
jspm_packages/

# Build output (Vercel rebuilds this on every deploy)
dist/
dist-ssr/
build/
*.local

# Secrets and environment variables.
# NEVER commit these: API keys, tokens, GHL credentials.
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Caches
.cache/
.temp/
.tmp/
.vite/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Hosting and tooling
.vercel/
.netlify/
.firebase/
.ngrok/
*.ngrok.yml

# Editors and IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# Operating system junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Archives and scratch files that tend to pile up in a project folder
*.zip
*.tar.gz
*.rar
*.bak
*.orig
*~